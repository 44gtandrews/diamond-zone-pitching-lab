rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }
    function approved() {
      return verified()
        && exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email))
        && get(/databases/$(database)/documents/allowlist/$(request.auth.token.email)).data.active == true;
    }
    function isAdmin() {
      return approved()
        && get(/databases/$(database)/documents/allowlist/$(request.auth.token.email)).data.role == 'admin';
    }
    match /allowlist/{email} {
      // Only verified accounts can read their own approval entry.
      allow get: if (verified() && request.auth.token.email == email) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['role', 'active'])
        && request.resource.data.role in ['coach', 'admin']
        && request.resource.data.active is bool;
      allow update: if isAdmin()
        && request.resource.data.keys().hasAll(['role', 'active'])
        && request.resource.data.role in ['coach', 'admin']
        && request.resource.data.active is bool
        && (email != request.auth.token.email ||
            (request.resource.data.role == 'admin' && request.resource.data.active == true));
      allow delete: if isAdmin() && email != request.auth.token.email;
    }
    // Verified new coaches may file exactly one self-owned access request.
    // They cannot read other applications or grant themselves permissions.
    match /coachRequests/{userId} {
      allow get: if isAdmin() || (verified() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create: if verified()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'email', 'status', 'requestedAt'])
        && request.resource.data.keys().hasAll(['uid', 'email', 'status', 'requestedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.requestedAt == resource.data.requestedAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['pending', 'approved', 'denied']
        && request.resource.data.reviewedBy == request.auth.token.email
        && request.resource.data.reviewedAt == request.time;
      allow delete: if isAdmin();
    }
    match /players/{playerId} {
      allow read: if approved();
      allow create: if isAdmin() || (approved()
        && request.resource.data.id == playerId
        && request.resource.data.publicId is string
        && request.resource.data.publicId.matches('^[1-9][0-9]{5}$')
        && getAfter(/databases/$(database)/documents/playerCodes/$(request.resource.data.publicId)).data.playerId == playerId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.ageNum is int
        && request.resource.data.sessions == 1
        && request.resource.data.dataType == 'aggregate'
        && request.resource.data.pitches is list
        && request.resource.data.pitches.size() > 0
        && request.resource.data.pitches.size() <= 8);
      allow update: if isAdmin() || (approved()
        && resource.data.dataType == 'aggregate'
        && request.resource.data.dataType == 'aggregate'
        && request.resource.data.id == resource.data.id
        && request.resource.data.name == resource.data.name
        && request.resource.data.ageNum == resource.data.ageNum
        && request.resource.data.ageLabel == resource.data.ageLabel
        && request.resource.data.sessions == resource.data.sessions + 1
        && request.resource.data.pitches is list
        && request.resource.data.pitches.size() > 0
        && request.resource.data.pitches.size() <= 8
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pitches','sessions','updatedBy','updatedAt','importHistory']));
      allow delete: if isAdmin();
    }
    // Collision-safe six-digit player IDs: players and reservations are written atomically.
    match /playerCodes/{code} {
      allow get, list: if approved();
      allow create: if approved()
        && code.matches('^[1-9][0-9]{5}$')
        && request.resource.data.keys().hasOnly(['playerId'])
        && request.resource.data.playerId is string
        && getAfter(/databases/$(database)/documents/players/$(request.resource.data.playerId)).data.publicId == code;
      allow update, delete: if false;
    }
    match /playerEdits/{playerId}/sections/{section} {
      allow get, list: if approved();
      allow create, update: if approved()
        && exists(/databases/$(database)/documents/players/$(playerId))
        && section in ['notes', 'mechanics', 'strength', 'grades', 'type-overrides']
        && request.resource.data.keys().hasOnly(['value', 'updatedAt', 'editedBy'])
        && request.resource.data.keys().hasAll(['value', 'updatedAt', 'editedBy'])
        && request.resource.data.value is string
        && request.resource.data.value.size() <= 50000
        && request.resource.data.editedBy == request.auth.token.email;
      allow delete: if isAdmin();
    }
    // Deny every unmentioned database path.
    match /{document=**} { allow read, write: if false; }
  }
}
