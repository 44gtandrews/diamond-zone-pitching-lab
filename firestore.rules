rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }
    function approvalPath() {
      return /databases/$(database)/documents/allowlist/$(request.auth.token.email);
    }
    function approved() {
      return verified() && exists(approvalPath())
        && get(approvalPath()).data.active == true;
    }
    function role() {
      return get(approvalPath()).data.role;
    }
    function isAdmin() {
      return approved() && role() == 'admin';
    }
    function isPitchingCoach() {
      return approved() && role() == 'pitching_coach';
    }
    function canWritePitching() {
      return isAdmin() || isPitchingCoach();
    }
    function canViewAll() {
      return approved() && role() in ['admin', 'pitching_coach', 'coach'];
    }
    function assignedParent(playerId) {
      return approved() && role() == 'player_parent'
        && get(approvalPath()).data.get('playerId', '') == playerId;
    }
    function validStaff(data) {
      return data.keys().hasAll(['role', 'active'])
        && data.role in ['admin', 'pitching_coach', 'coach', 'player_parent']
        && data.active is bool
        && (
          (data.role == 'player_parent'
            && data.keys().hasAll(['playerId'])
            && data.playerId is string
            && exists(/databases/$(database)/documents/players/$(data.playerId)))
          ||
          (data.role != 'player_parent' && !data.keys().hasAny(['playerId']))
        );
    }

    // Frontend rollout gate: a successful get (even if the doc is missing)
    // confirms that Role Policy v2 rules have been published. No listing or writing.
    match /rolePolicy/{policy} {
      allow get: if verified() && policy == 'v2';
      allow list, create, update, delete: if false;
    }
    match /allowlist/{email} {
      allow get: if isAdmin() || (verified() && request.auth.token.email == email);
      allow list: if isAdmin();
      allow create: if isAdmin() && validStaff(request.resource.data);
      allow update: if isAdmin()
        && validStaff(request.resource.data)
        // An administrator cannot deactivate or demote their own account.
        && (email != request.auth.token.email ||
            (request.resource.data.role == 'admin' && request.resource.data.active == true));
      allow delete: if isAdmin() && email != request.auth.token.email;
    }
    // The client may record its latest authenticated sign-in time, but ONLY
    // when it exactly matches the Firebase ID token's signed auth_time claim.
    // No self-assigned roles, arbitrary timestamps, or foreign account reads.
    match /userLogins/{email} {
      function ownsLogin() {
        return approved()
          && request.auth.token.email.lower() == email;
      }
      function validLogin() {
        return ownsLogin()
          && request.resource.data.keys().hasOnly(
            ['email','uid','authTimeSeconds','recordedAt'])
          && request.resource.data.keys().hasAll(
            ['email','uid','authTimeSeconds','recordedAt'])
          && request.resource.data.email == email
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.authTimeSeconds is int
          && request.resource.data.authTimeSeconds == request.auth.token.auth_time
          && request.resource.data.recordedAt == request.time;
      }
      allow get: if isAdmin() || ownsLogin();
      allow list: if isAdmin();
      allow create: if validLogin();
      allow update: if validLogin()
        && resource.data.email == email
        && resource.data.authTimeSeconds is int
        && request.resource.data.authTimeSeconds > resource.data.authTimeSeconds;
      allow delete: if false;
    }
    match /coachRequests/{userId} {
      // Applicant-provided registration intent is not an access grant.
      function validApplicant() {
        return request.auth != null
          && request.auth.uid == userId
          && request.auth.token.email is string
          && request.resource.data.keys().hasOnly([
            'uid','email','status','requestedAt','requestedRole','playerName','playerCode'
          ])
          && request.resource.data.keys().hasAll([
            'uid','email','status','requestedAt','requestedRole','playerName','playerCode'
          ])
          && request.resource.data.uid == userId
          && request.resource.data.email == request.auth.token.email.lower()
          && request.resource.data.requestedAt == request.time
          && request.resource.data.status ==
             (request.auth.token.email_verified == true ? 'pending' : 'awaiting_verification')
          && request.resource.data.requestedRole in ['player','parent','coach']
          && request.resource.data.playerName is string
          && request.resource.data.playerCode is string
          && (
            (request.resource.data.requestedRole == 'coach'
              && request.resource.data.playerName == ''
              && request.resource.data.playerCode == '')
            ||
            (request.resource.data.requestedRole in ['player','parent']
              && request.resource.data.playerName.size() >= 2
              && request.resource.data.playerName.size() <= 100
              && (request.resource.data.playerCode == ''
                  || request.resource.data.playerCode.matches('^[1-9][0-9]{5}$')))
          );
      }
      allow get: if isAdmin() || (verified() && request.auth.uid == userId);
      allow list: if isAdmin();
      // Keep legacy verified request creation and admin backup restore compatible.
      allow create: if (isAdmin()
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.status in ['awaiting_verification','pending','approved','denied']
        && request.resource.data.requestedAt is timestamp)
        || validApplicant()
        || (verified()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'email', 'status', 'requestedAt'])
        && request.resource.data.keys().hasAll(['uid', 'email', 'status', 'requestedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time);
      // Only a verified user may promote their own awaiting request to pending.
      // They cannot change role, linked player, status to approved, or review fields.
      allow update: if (verified()
        && request.auth.uid == userId
        && resource.data.status == 'awaiting_verification'
        && resource.data.email == request.auth.token.email.lower()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'pending')
        || (isAdmin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.requestedAt == resource.data.requestedAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['pending', 'approved', 'denied']
        && request.resource.data.reviewedBy == request.auth.token.email
        && request.resource.data.reviewedAt == request.time);
      allow delete: if isAdmin();
    }
    match /players/{playerId} {
      // Player/Parent may get ONLY their linked active profile, never list the roster.
      allow get: if canViewAll()
        || (assignedParent(playerId) && resource.data.get('inactive', false) != true);
      allow list: if canViewAll();
      allow create: if isAdmin() || (isPitchingCoach()
        && request.resource.data.id == playerId
        && request.resource.data.publicId is string
        && request.resource.data.publicId.matches('^[1-9][0-9]{5}$')
        && getAfter(/databases/$(database)/documents/playerCodes/$(request.resource.data.publicId)).data.playerId == playerId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.ageNum is int
        && request.resource.data.sessions == 1
        && request.resource.data.dataType == 'aggregate'
        && request.resource.data.pitches is list
        && request.resource.data.pitches.size() > 0
        && request.resource.data.pitches.size() <= 8);
      allow update: if isAdmin() || (isPitchingCoach()
        && resource.data.get('inactive', false) != true
        && resource.data.dataType == 'aggregate'
        && request.resource.data.dataType == 'aggregate'
        && request.resource.data.id == resource.data.id
        && request.resource.data.name == resource.data.name
        && request.resource.data.ageNum == resource.data.ageNum
        && request.resource.data.ageLabel == resource.data.ageLabel
        && request.resource.data.sessions == resource.data.sessions + 1
        && request.resource.data.pitches is list
        && request.resource.data.pitches.size() > 0
        && request.resource.data.pitches.size() <= 8
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['pitches', 'sessions', 'updatedBy', 'updatedAt', 'importHistory']));
      allow delete: if isAdmin();
    }
    // Per-player sessions are independent, immutable source records.
    // Player/parents can read ONLY their own linked, active pitcher's sessions.
    // The profile aggregates in /players are retained for legacy/rollback use.
    match /players/{playerId}/sessions/{sessionId} {
      allow get, list: if canViewAll() ||
        (assignedParent(playerId) &&
         exists(/databases/$(database)/documents/players/$(playerId)) &&
         get(/databases/$(database)/documents/players/$(playerId)).data.get('inactive', false) != true);
      allow create: if canWritePitching() &&
        getAfter(/databases/$(database)/documents/players/$(playerId)).data.id == playerId &&
        getAfter(/databases/$(database)/documents/players/$(playerId)).data.get('inactive', false) != true &&
        request.resource.data.id == sessionId &&
        request.resource.data.kind in ['single','baseline','historical'] &&
        request.resource.data.pitches is list &&
        request.resource.data.pitches.size() > 0 &&
        request.resource.data.pitches.size() <= 8 &&
        request.resource.data.pitchData is list &&
        request.resource.data.pitchData.size() <= 600 &&
        request.resource.data.importedBy is string &&
        (isAdmin() || request.resource.data.importedBy == request.auth.token.email) &&
        // Admin overrides are enforced by Firestore, not just a browser checkbox.
        (!request.resource.data.keys().hasAny(['adminOverride']) ||
         (isAdmin()
          && request.resource.data.adminOverride is map
          && request.resource.data.adminOverride.types is list
          && request.resource.data.adminOverride.types.size() > 0
          && request.resource.data.adminOverride.types.size() <= 2
          && request.resource.data.adminOverride.approvedBy == request.auth.token.email.lower()));
      // No silent rewriting/deletion of session records by regular coaches.
      allow update, delete: if isAdmin();
    }
    // Daily pitch-count calendar: approved coaching staff can edit; linked
    // players and parents can view only their own active player's dates.
    match /players/{playerId}/pitchCounts/{dayId} {
      function activePlayer() {
        return exists(/databases/$(database)/documents/players/$(playerId))
          && get(/databases/$(database)/documents/players/$(playerId)).data.get('inactive', false) != true;
      }
      function validPitchCount() {
        return canWritePitching()
          && exists(/databases/$(database)/documents/players/$(playerId))
          && dayId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['date', 'month', 'count', 'type', 'updatedBy', 'updatedAt'])
          && request.resource.data.keys().hasAll(['date', 'month', 'count', 'updatedBy', 'updatedAt'])
          && request.resource.data.date == dayId
          && request.resource.data.month is string
          && request.resource.data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && dayId.matches(request.resource.data.month + '-[0-9]{2}')
          && request.resource.data.count is int
          && request.resource.data.count >= 1
          && request.resource.data.count <= 999
          && (!request.resource.data.keys().hasAny(['type']) || request.resource.data.type in ['game', 'bullpen'])
          && request.resource.data.updatedBy == request.auth.token.email.lower()
          && request.resource.data.updatedAt == request.time;
      }
      allow get, list: if canViewAll() ||
        (assignedParent(playerId) && activePlayer());
      allow create, update: if validPitchCount();
      allow delete: if canWritePitching()
        && exists(/databases/$(database)/documents/players/$(playerId));
    }
    // Per-player calendars and reusable day libraries. Admin access is checked
    // by the server for every read/write, independent of hidden UI controls.
    match /players/{playerId}/atHomePlans/{weekId} {
      function validPlan() {
        return isAdmin()
          && exists(/databases/$(database)/documents/players/$(playerId))
          && weekId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(
            ['weekStart', 'title', 'notes', 'rows', 'revision', 'updatedBy', 'updatedAt', 'schedule', 'assignmentsVersion'])
          && request.resource.data.keys().hasAll(
            ['weekStart', 'title', 'notes', 'rows', 'revision', 'updatedBy', 'updatedAt'])
          && request.resource.data.weekStart == weekId
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 120
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 3000
          && request.resource.data.rows is list
          && request.resource.data.rows.size() <= 80
          && request.resource.data.revision is int
          && request.resource.data.updatedBy == request.auth.token.email.lower()
          && request.resource.data.updatedAt == request.time
          && (
            !request.resource.data.keys().hasAny(['schedule', 'assignmentsVersion'])
            ||
            (request.resource.data.keys().hasAll(['schedule', 'assignmentsVersion'])
             && request.resource.data.assignmentsVersion == 1
             && request.resource.data.schedule is list
             && request.resource.data.schedule.size() == 7
             && request.resource.data.schedule[0] is list
             && request.resource.data.schedule[1] is list
             && request.resource.data.schedule[2] is list
             && request.resource.data.schedule[3] is list
             && request.resource.data.schedule[4] is list
             && request.resource.data.schedule[5] is list
             && request.resource.data.schedule[6] is list
             && request.resource.data.schedule[0].size() <= 4
             && request.resource.data.schedule[1].size() <= 4
             && request.resource.data.schedule[2].size() <= 4
             && request.resource.data.schedule[3].size() <= 4
             && request.resource.data.schedule[4].size() <= 4
             && request.resource.data.schedule[5].size() <= 4
             && request.resource.data.schedule[6].size() <= 4)
          );
      }
      allow get, list: if isAdmin();
      allow create: if validPlan() && request.resource.data.revision == 1;
      allow update: if validPlan()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if isAdmin();
    }
    match /players/{playerId}/atHomeDays/{libraryId} {
      function validLibrary() {
        return isAdmin()
          && libraryId == 'library'
          && exists(/databases/$(database)/documents/players/$(playerId))
          && request.resource.data.keys().hasOnly(['templates', 'revision', 'updatedBy', 'updatedAt'])
          && request.resource.data.keys().hasAll(['templates', 'revision', 'updatedBy', 'updatedAt'])
          && request.resource.data.templates is list
          && request.resource.data.templates.size() <= 40
          && request.resource.data.revision is int
          && request.resource.data.updatedBy == request.auth.token.email.lower()
          && request.resource.data.updatedAt == request.time;
      }
      allow get, list: if isAdmin() && libraryId == 'library';
      allow create: if validLibrary() && request.resource.data.revision == 1;
      allow update: if validLibrary()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if isAdmin() && libraryId == 'library';
    }
    match /playerCodes/{code} {
      allow get, list: if canViewAll();
      allow create: if canWritePitching()
        && code.matches('^[1-9][0-9]{5}$')
        && request.resource.data.keys().hasOnly(['playerId'])
        && request.resource.data.playerId is string
        && getAfter(/databases/$(database)/documents/players/$(request.resource.data.playerId)).data.publicId == code;
      allow update, delete: if false;
    }
    match /playerEdits/{playerId}/sections/{section} {
      allow get: if canViewAll() || (assignedParent(playerId)
        && exists(/databases/$(database)/documents/players/$(playerId))
        && get(/databases/$(database)/documents/players/$(playerId)).data.get('inactive', false) != true);
      allow list: if canViewAll();
      allow create, update: if canWritePitching()
        && exists(/databases/$(database)/documents/players/$(playerId))
        && section in ['notes', 'mechanics', 'strength', 'grades', 'type-overrides']
        && request.resource.data.keys().hasOnly(['value', 'updatedAt', 'editedBy'])
        && request.resource.data.keys().hasAll(['value', 'updatedAt', 'editedBy'])
        && request.resource.data.value is string
        && request.resource.data.value.size() <= 50000
        && (isAdmin() || request.resource.data.editedBy == request.auth.token.email);
      allow delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
